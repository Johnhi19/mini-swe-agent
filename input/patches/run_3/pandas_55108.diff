     def _difference(self, other, sort):
         # overridden by RangeIndex
         other = other.unique()
-        the_diff = self[other.get_indexer_for(self) == -1]
+
+        # First, try to get an indexer from 'other' onto 'self'. If this
+        # returns an array aligned to self (len(self)), we can directly
+        # boolean-index self. This preserves the coercion behavior of
+        # datetimelike Index subclasses when 'other' can interpret
+        # self's values (e.g. PeriodIndex vs Index[str]).
+        try:
+            idx = other.get_indexer_for(self)
+        except Exception:
+            idx = None
+
+        if idx is not None and getattr(idx, '__len__', lambda: None)() == len(self):
+            the_diff = self[idx == -1]
+        else:
+            # Fallback: use self.get_indexer_for(other), which returns
+            # positions in self for elements of other. Build a boolean
+            # mask for self and exclude those positions.
+            idx2 = self.get_indexer_for(other)
+            mask = np.ones(len(self), dtype=bool)
+            if getattr(idx2, '__len__', lambda: 0)() > 0:
+                pos = idx2[idx2 != -1]
+                if len(pos):
+                    mask[pos] = False
+            the_diff = self[mask]
+
         the_diff = the_diff if self.is_unique else the_diff.unique()
         the_diff = _maybe_try_sort(the_diff, sort)
         return the_diff
 
+
     def _wrap_difference_result(self, other, result):
         # We will override for MultiIndex to handle empty results
         return self._wrap_setop_result(other, result)
